import /vendor/etc/init/hw/init.amlogic.usb.rc

on early-init
    loglevel 3

    mount configfs configfs /sys/kernel/config
    #mount usbfs none /proc/bus/usb
    insmod /vendor/lib/modules/mali.ko
    insmod /vendor/lib/modules/optee.ko
    insmod /vendor/lib/modules/optee_armtz.ko

on init
    chmod 666 /dev/tee0
    chmod 666 /dev/teepriv0
    start tee_supplicant

on post-fs
    chmod 0660 /dev/stpbt
    chown bluetooth bluetooth /dev/stpbt
    start tee_hdcp

on post-fs-data
    insmod /vendor/lib/modules/cfg80211.ko
    insmod /vendor/lib/dovi.ko
    insmod /system/lib/modules/btmtksdio.ko

on boot
    setprop ro.radio.noril true
    #A53 will be set performance in raven.rc, set the min_freq of A73 to 1G
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_min_freq 1000000
#HDMI IN
    chmod 666 /sys/class/sii9233a/port
    chmod 666 /sys/class/sii9233a/enable
    chmod 666 /sys/module/tvin_vdin/parameters/max_buf_num

    # chmod 0666 /dev/ge2d
    chmod 660 /dev/cec
    chmod 0666 /dev/opteearmtz00

#NET LED
    chmod 666 sys/class/leds/net_green/brightness
    chmod 666 sys/class/leds/net_red/brightness

service tee_supplicant /vendor/bin/tee-supplicant
	class core
	oneshot
	seclabel u:r:tee:s0

service tee_hdcp /vendor/bin/tee_hdcp
    class main
    oneshot
    seclabel u:r:tee:s0
